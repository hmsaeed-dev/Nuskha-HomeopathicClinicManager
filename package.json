{
  "name": "nuskha",
  "version": "0.1.0",
  "private": true,
  "description": "Nuskha Homoeopathic Clinic Desktop Workspace",
  "author": "Nuskha Clinic",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "npm run desktop:tsc && concurrently -k -n next,desktop -c green,cyan \"next dev -p 3000\" \"wait-on -t 120000 http-get://localhost:3000 && npm run dev:desktop:electron\"",
    "dev:desktop:electron": "cross-env NUSKHA_DEV_URL=http://localhost:3000 electron .",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backup": "tsx src/db/backup.ts",
    "desktop:tsc": "tsc -p desktop/tsconfig.json",
    "desktop:prepare": "node desktop/prepare-standalone.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && npm run desktop:tsc",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "mssql": "^12.8.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/mssql": "^12.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
